# Required: ElevenLabs API key for agent creation and phone integration
ELEVENLABS_API_KEY=

# Set after running: npx tsx src/scripts/setup-agent.ts
ELEVENLABS_AGENT_ID=

# Browser-accessible agent ID for optional web conversation via @elevenlabs/react
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Required for build pipeline: push the implementation branch and create the draft PR
# Also unlocks private repos and higher rate limits (5000/hr vs 60/hr)
GITHUB_TOKEN=

# App URL (used as the ElevenLabs webhook base URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for build pipeline: passed through to Claude Code CLI for code generation
ANTHROPIC_API_KEY=
