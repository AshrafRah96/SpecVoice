# Required: ElevenLabs API key for agent creation and phone integration
ELEVENLABS_API_KEY=

# Required in production; set to the ElevenLabs HMAC webhook signing secret.
ELEVENLABS_WEBHOOK_SECRET=

# Set after running: npx tsx src/scripts/setup-agent.ts
ELEVENLABS_AGENT_ID=

# Dashboard login. Generate with the setup wizard; quote the hash literally in .env.
SPECVOICE_OPERATOR_PASSWORD_HASH=
SPECVOICE_OPERATOR_ORIGIN=http://localhost:3000

# Required for build pipeline: push the implementation branch and create the draft PR
# Also unlocks private repos and higher rate limits (5000/hr vs 60/hr)
GITHUB_TOKEN=
GITHUB_READ_TOKEN=

# App URL (used as the ElevenLabs webhook base URL)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Leave empty for local memory development. Compose injects its internal database URL.
# For host-run PostgreSQL development, set a URL for your own reachable database.
DATABASE_URL=

# The execution image pins Claude Code 2.1.296 in Dockerfile and Compose.
SPECVOICE_SERVICE_SECRET=
SPECVOICE_BUILD_BUDGET_USD=5
SPECVOICE_EXECUTION_CPUS=2
SPECVOICE_EXECUTION_MEMORY_BYTES=4294967296
SPECVOICE_EXECUTION_WORKSPACE_BYTES=2147483648
SPECVOICE_EXECUTION_PIDS=256
SPECVOICE_EXECUTION_DEADLINE_MS=1800000
# Explicit comma-separated repository URLs permitted to run npm install lifecycle scripts.
SPECVOICE_INSTALL_SCRIPT_REPOS=

# Docker worker egress proxy. Keep this list narrow; comma-separated host suffixes.
SPECVOICE_EGRESS_ALLOWLIST=github.com,api.github.com,codeload.github.com,objects.githubusercontent.com,raw.githubusercontent.com,registry.npmjs.org,registry.yarnpkg.com
SPECVOICE_PROFILE_SMALL_MAX_FILES=5000
SPECVOICE_PROFILE_SMALL_MAX_BYTES=50000000
SPECVOICE_PROFILE_MID_MAX_FILES=25000
SPECVOICE_PROFILE_MID_MAX_BYTES=250000000
SPECVOICE_PROFILE_LARGE_MAX_FILES=100000
SPECVOICE_PROFILE_LARGE_MAX_BYTES=1000000000
SPECVOICE_PROFILE_MAX_FILES=100000
SPECVOICE_PROFILE_MAX_BYTES=1000000000
SPECVOICE_PROFILE_MAX_DURATION_MS=30000

# Real model key stays in the model gateway; execution receives a bounded attempt credential.
ANTHROPIC_API_KEY=

# Required for call-bound provider tool capabilities. Use a random 32+ character value.
SESSION_CAPABILITY_SECRET=

# Required when local repositories are used. Paths must stay below this directory.
SPECVOICE_LOCAL_REPO_ROOT=

# In-memory sessions are available in tests/development only. Production requires DATABASE_URL.

# Durable retention; hourly cleanup and a startup sweep preserve saved planning records.
SPECVOICE_TRANSCRIPT_RETENTION_DAYS=30
SPECVOICE_METRICS_RETENTION_DAYS=180
SPECVOICE_INDEX_RETENTION_DAYS=7

# Optional encrypted backup override: configure these with scripts/setup-local.sh.
# Destination must be a mounted second disk/NAS, not the application's disk.
SPECVOICE_BACKUP_DESTINATION=
SPECVOICE_BACKUP_PASSWORD_FILE=
SPECVOICE_BACKUP_VOLUME_ID=
SPECVOICE_BACKUP_UID=
SPECVOICE_BACKUP_GID=

# Synthetic live evaluations reserve this operator-calibrated estimate before paid requests.
# Empty estimate disables live evaluation. Billing can lag; this is not a hard ceiling.
SPECVOICE_LIVE_BUDGET_USD=10
SPECVOICE_LIVE_EVAL_ESTIMATE_USD=
SPECVOICE_LIVE_TEST_REPO=

# Compose database identity; the setup wizard generates a URL-safe random password.
POSTGRES_USER=specvoice
POSTGRES_DB=specvoice
POSTGRES_PASSWORD=
