  "cards": [
    {
      "dot": "cyan",
      "title": "Voice to Spec",
      "items": [
        "Web issues a private signed call URL. Tools require a live call capability; callbacks require HMAC.",
        "Repository discovery uses a pinned commit. Partial and larger profiles require confirmed scope before Build."
      ]
    },
    {
      "dot": "emerald",
      "title": "Explicit Build, trusted publication",
      "items": [
        "Call completion and an explicit Build request gate generation. Worker validates changed paths before push.",
        "Missing generated output requires a new Build. Publication reconciliation never reruns Claude."
      ]
    },
    {
      "dot": "rose",
      "title": "Local isolation, explicit limits",
      "items": [
        "Single-host Docker Compose. Execution receives no database credentials, GitHub write token or Docker socket.",
        "Docker shares the host kernel. Model budgets are estimates; external backup recovery still needs operator setup."
      ]
    }
  ]
