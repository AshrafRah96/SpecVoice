{
  "name": "spec-voice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "egress-proxy": "tsx src/egress-proxy.ts",
    "worker": "tsx src/workers/build-worker.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent": "npx tsx src/scripts/test-agent.ts",
    "setup:agent": "tsx src/scripts/setup-agent.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "eval:offline": "node --import tsx src/scripts/run-offline-evals.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:isolation": "node --import tsx src/scripts/test-isolation.ts",
    "retention": "node --import tsx src/scripts/retention.ts",
    "backup": "node --import tsx src/scripts/backups.ts",
    "test:backups": "node --import tsx src/scripts/test-backups.ts",
    "test:compose": "node --import tsx src/scripts/test-compose.ts",
    "bench:repositories": "node --import tsx src/scripts/benchmark-repositories.ts",
    "ops:status": "node --import tsx src/scripts/ops-status.ts",
    "graphify:refresh": "python3 scripts/graphify-refresh.py"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.39.0",
    "@elevenlabs/react": "^0.14.3",
    "@octokit/rest": "^20.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "ignore": "^5.3.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.1.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  }
}
